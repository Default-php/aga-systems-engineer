# Copy this file to .env and fill in real values.
# .env is gitignored and must never be committed.

# Django secret key (use `python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"` to generate)
SECRET_KEY=changeme-to-a-real-secret-key

# Set to False in production
DEBUG=True

# Comma-separated list of allowed hosts
ALLOWED_HOSTS=localhost,127.0.0.1

# Contact form email (defaults shown; override if needed)
DEFAULT_FROM_EMAIL=noreply@example.com
CONTACT_RECIPIENT_EMAIL=alfonso.ga@proton.me
