# Copy this file to .env and fill in real values.
# .env is gitignored and must never be committed.

# Django secret key (use `python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"` to generate)
SECRET_KEY=changeme-to-a-real-secret-key

# Set to False in production
DEBUG=True

# Comma-separated list of allowed hosts
# (Docker Compose forwards this to the web container as ALLOWED_HOSTS)
ALLOWED_HOSTS=localhost,127.0.0.1

# Contact form email (defaults shown; override if needed)
DEFAULT_FROM_EMAIL=noreply@example.com
CONTACT_RECIPIENT_EMAIL=alfonso.ga@proton.me

# Site-wide SEO meta description (used for meta description / Open Graph)
SITE_DESCRIPTION=Systems engineer with expertise in AI integration, cloud, automation, Docker, and DevOps.

# Set to True when deployed behind a TLS-terminating reverse proxy
SECURE_PROXY_SSL_HEADER_ENABLED=False

# Docker Compose (task 4.2) — required for `docker compose up` (no default)
POSTGRES_PASSWORD=change-me-strong-password

# OpenRouter chat assistant (task 4.5) — empty key enables demo mode in dev
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto:free
